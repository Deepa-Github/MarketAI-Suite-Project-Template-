# ──────────────────────────────────────────────────────────────
# MarketAI Suite — .gitignore
# ──────────────────────────────────────────────────────────────

# Environment — NEVER commit secrets
.env
*.env
.env.*
!.env.example

# Python virtual environment
venv/
env/
.venv/
.ENV/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
*.pytest_cache/

# IDE and editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Database files (local dev database)
database/*.db
database/*.db-shm
database/*.db-wal

# Exports / generated reports (transient artifacts)
exports/generated_reports/*.csv
exports/generated_reports/*.pdf
exports/generated_reports/*.json

# Uploaded files (transient)
uploads/

# Ngrok config (contains auth token)
ngrok.yml
ngrok.yaml
.ngrok2/

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
