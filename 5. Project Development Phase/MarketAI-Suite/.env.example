# MarketAI Suite — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ──────────────────────────────────────────────────────────────
# GROQ API CONFIGURATION
# ──────────────────────────────────────────────────────────────
# Obtain your API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use — change this to switch models without code changes.
GROQ_MODEL=llama-3.3-70b-versatile

# AI generation defaults (optional — sensible defaults apply if omitted)
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT=120

# ──────────────────────────────────────────────────────────────
# FLASK CONFIGURATION
# ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=True

# IMPORTANT: Change this to a long, random string in production.
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production

# Flask host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ──────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────
DATABASE_PATH=database/marketai.db

# ──────────────────────────────────────────────────────────────
# FILE UPLOAD LIMITS
# ──────────────────────────────────────────────────────────────
# Maximum allowed CSV upload size in bytes (default: 10 MB)
MAX_CONTENT_LENGTH=10485760

# ──────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/marketai.log

# ──────────────────────────────────────────────────────────────
# RATE LIMITING (requests per minute per IP)
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
